    val = val(:)';
end


function emgOut = mep_blank(emgIn, trigSamples, blankMs, fs)
% Linear interpolation MEP blanking (0 to blankMs post-TMS), applied to
% the FULL continuous signal, all channels, before any epoching.
    emgOut = emgIn;
    blankSamp = round(blankMs * fs / 1000);
    nCh = size(emgIn, 1);
    nSamp = size(emgIn, 2);

    for tr = 1:numel(trigSamples)
        i0 = trigSamples(tr);
        i1 = min(i0 + blankSamp, nSamp);
        if i0 < 1 || i0 >= i1
            continue
        end
        for ch = 1:nCh
            v0 = emgIn(ch, max(i0-1,1));
            v1 = emgIn(ch, min(i1+1, nSamp));
            emgOut(ch, i0:i1) = linspace(v0, v1, i1 - i0 + 1);
        end
    end
end


function emgOut = apply_notch_filters(emgIn, fs, notchFreqs_Hz, bw_Hz)
% FIX #5: 50Hz + 100Hz zero-phase IIR notch filtering (bandwidth bw_Hz),
% applied to every channel - matches Methods 2.5.2, which described this
% step but the code never actually implemented it. Called after MEP
% blanking, before any band-specific filtering, in every extraction path
% in this script (primary, reverse-only filter check, rebound-frequency
% sweep, MEP-blanking sensitivity).
    nyq = fs / 2;
    emgOut = emgIn;
    nCh = size(emgIn, 1);
    for f0 = notchFreqs_Hz
        [bn, an] = iirnotch(f0/nyq, bw_Hz/nyq);
        for ch = 1:nCh
            emgOut(ch, :) = filtfilt(bn, an, emgOut(ch, :));
        end
    end
end


function [sigOut, fsOut] = filter_and_downsample(sigIn, fsIn, band_Hz, fsOut)
% Zero-phase Butterworth bandpass (order 4, sos form), then downsample
% to EXACTLY fsOut using resample() with an exact rational factor.
%
% FIX #7: previously used decimate() with dsFactor=round(fsIn/fsOut),
% which only supports integer decimation factors - fsIn/fsOut=5120/500
% is NOT an integer (10.24), so decimate() silently rounded that to 10
% and the "500Hz" output was actually 512Hz (5120/10). Likewise the
% previous "2000Hz" high-gamma downsampling was actually 1706.7Hz
% (5120/3, since round(5120/2000)=3). resample(x,p,q) resamples at
% EXACTLY p/q times the input rate; rat() finds an exact (or best)
% rational p/q for the requested ratio, so the achieved rate is checked
% and reported rather than assumed.
    nyq = fsIn / 2;
    [z, p, k] = butter(4, band_Hz / nyq, 'bandpass');
    sos = zp2sos(z, p, k);

    nCh = size(sigIn, 1);
    sigFilt = zeros(size(sigIn));
    for ch = 1:nCh
        sigFilt(ch, :) = filtfilt(sos, 1, sigIn(ch, :));
    end

    if fsOut >= fsIn
        sigOut = sigFilt;
        fsOut = fsIn;
        return
    end

    [p, q] = rat(fsOut / fsIn);
    fsAchieved = fsIn * p / q;
    if abs(fsAchieved - fsOut) > 0.01
        warning('resample() could not hit %g Hz exactly - achieved %.4f Hz instead (p=%d, q=%d).', ...
            fsOut, fsAchieved, p, q);
    end

    nCh = size(sigFilt, 1);
    sigOut = [];
    for ch = 1:nCh
        chDs = resample(sigFilt(ch, :), p, q);
        if isempty(sigOut)
            sigOut = zeros(nCh, numel(chDs));
        end
        sigOut(ch, :) = chDs;
    end
    fsOut = fsAchieved;
end


function [sigOut, fsOut] = filter_and_downsample_reverseOnly(sigIn, fsIn, band_Hz, fsOut)
% Same bandpass + downsample as filter_and_downsample, but replaces the
% zero-phase filtfilt/sos step with a REVERSE-ONLY (anti-causal) filter -
% see the header/original comment for the full methodological reasoning.
% FIX #7 applied here too: resample() instead of decimate() for the
% exact requested rate.
    nyq = fsIn / 2;
    [z, p, k] = butter(4, band_Hz / nyq, 'bandpass');
    sos = zp2sos(z, p, k);

    nCh = size(sigIn, 1);
    sigFilt = zeros(size(sigIn));
    for ch = 1:nCh
        xRev = flip(sigIn(ch, :));
        yRev = sosfilt(sos, xRev);
        sigFilt(ch, :) = flip(yRev);
    end

    if fsOut >= fsIn
        sigOut = sigFilt;
        fsOut = fsIn;
        return
    end

    [p, q] = rat(fsOut / fsIn);
    fsAchieved = fsIn * p / q;

    nCh = size(sigFilt, 1);
    sigOut = [];
    for ch = 1:nCh
        chDs = resample(sigFilt(ch, :), p, q);
        if isempty(sigOut)
            sigOut = zeros(nCh, numel(chDs));
        end
        sigOut(ch, :) = chDs;
    end
    fsOut = fsAchieved;
end


function result = run_filter_sensitivity(PID, cond, dataDir, nBlocks, ...
        trigField, forceField, emgPrefix, nCh, fsRaw, firstTrig, ...
        mepBlankMs, notchFreqs_Hz, notchBw_Hz, selectedCh, trSPOff, trBlockTrials, band)
% Re-runs epoching/TF/normalization for one SP-offset-epoched band using
% filter_and_downsample_reverseOnly instead of the primary filtfilt.
% FIX #3 (block/trial mapping) and FIX #5 (notch filtering) applied here
% too, per the review's explicit instruction. FIX #6 (hierarchical
% averaging) applied as well for direct comparability with the primary
% result.

    if isfield(band, 'computeWin_ms') && ~isempty(band.computeWin_ms)
        extractWin_ms = band.computeWin_ms;
    else
        extractWin_ms = band.epochWin_ms;
    end

    epochsTF    = [];
    timeAxis_ms = [];
    epochCount  = 0;
    epochTrialKey = [];
    nSelCh      = numel(selectedCh);

    for blockNum = 1:nBlocks
        rawFile = fullfile(dataDir, sprintf('%s_%s_%d.mat', PID, cond, blockNum));
        if exist(rawFile, 'file') ~= 2, continue; end

        raw = load_quattrocento_block(rawFile, trigField, forceField, ...
                                       emgPrefix, nCh, fsRaw);
        trigSamples = raw.trigSamples(firstTrig:end);

        emgBlanked  = mep_blank(raw.emg, trigSamples, mepBlankMs, fsRaw);
        emgPrepared = apply_notch_filters(emgBlanked, fsRaw, notchFreqs_Hz, notchBw_Hz);
        [emgFilt, Fs_ds] = filter_and_downsample_reverseOnly(emgPrepared, fsRaw, ...
                                band.filtBand_Hz, band.downFs);

        for chLocalIdx = 1:nSelCh
            ch  = selectedCh(chLocalIdx);
            sig = emgFilt(ch, :);

            for tr = 1:numel(trigSamples)
                rowIdx = find(trBlockTrials(:,1) == blockNum & trBlockTrials(:,2) == tr, 1);
                if isempty(rowIdx), continue; end

                spOff_ms = trSPOff(rowIdx, chLocalIdx);
                if ~isfinite(spOff_ms), continue; end
                dsFactor_local = fsRaw / Fs_ds;
                trigSamp_ds = round(trigSamples(tr) / dsFactor_local);
                t0_ds = trigSamp_ds + round(spOff_ms * Fs_ds / 1000);
                if ~isfinite(t0_ds), continue; end

                win_samp = round(extractWin_ms * Fs_ds / 1000);
                idx0 = t0_ds + win_samp(1);
                idx1 = t0_ds + win_samp(2);
                if idx0 < 1 || idx1 > numel(sig), continue; end

                epoch = sig(idx0:idx1);
                if band.detrend, epoch = detrend(epoch); end

                tf = faslt_kw(epoch, Fs_ds, band.freqs, band.c1, ...
                              band.orderRange, band.mult, band.ksd);

                if isempty(epochsTF)
                    nT = size(tf, 2);
                    timeAxis_ms = linspace(extractWin_ms(1), extractWin_ms(2), nT);
                    epochsTF = zeros(numel(band.freqs), nT, 0);
                end
                epochCount = epochCount + 1;
                epochsTF(:, :, epochCount) = tf; %#ok<AGROW>
                epochTrialKey(epochCount) = rowIdx; %#ok<AGROW>
            end
        end
    end

    result = struct('label', 'reverse_only', 'freqs', band.freqs, ...
        'time_ms', [], 'avgERSP', [], 'nEpochs', epochCount);

    if epochCount == 0
        warning('No epochs for reverse-only filter sensitivity (%s %s %s) - skipping.', PID, cond, band.name);
        return
    end

    [normTF, ~] = double_zscore_normalize(epochsTF, timeAxis_ms, band.baselineWin_ms, band.normMethod);
    [perTrialTF, ~] = trial_averaged_tf(normTF, epochTrialKey);
    avgTF = mean(perTrialTF, 3, 'omitnan');

    if isfield(band, 'computeWin_ms') && ~isempty(band.computeWin_ms)
        cropIdx = timeAxis_ms >= band.epochWin_ms(1) & timeAxis_ms <= band.epochWin_ms(2);
        avgTF = avgTF(:, cropIdx);
        timeAxis_ms = timeAxis_ms(cropIdx);
    end

    result.time_ms = timeAxis_ms;
    result.avgERSP = avgTF;
end


function traceMat = channel_averaged_trace(normTF, epochChLocalIdx, nSelCh)
% [nSelCh x time], averaging over frequency and over that channel's
% trials. Row i stays aligned with selectedCh(i) even for a channel with
% zero surviving epochs (NaN row).
    nT = size(normTF, 2);
    traceMat = nan(nSelCh, nT);
    for ch = 1:nSelCh
        mask = (epochChLocalIdx == ch);
        if ~any(mask), continue; end
        freqTime = mean(normTF(:, :, mask), 3);
        traceMat(ch, :) = mean(freqTime, 1);
    end
end


function [traceMat, sortedKeys] = trial_averaged_trace(normTF, epochTrialKey)
% [nTrials x time], averaging over frequency and over that trial's
% channels (freq-collapsed - for line-trace outputs). sortedKeys are now
% genuine trSPOff/trSPD row indices (FIX #3), not synthetic
% blockNum*1000+tr keys.
    sortedKeys = unique(epochTrialKey);
    nT = size(normTF, 2);
    traceMat = nan(numel(sortedKeys), nT);
    for k = 1:numel(sortedKeys)
        mask = (epochTrialKey == sortedKeys(k));
        if ~any(mask), continue; end
        freqTime = mean(normTF(:, :, mask), 3);
        traceMat(k, :) = mean(freqTime, 1);
    end
end


function [perTrialTF, sortedKeys] = trial_averaged_tf(normTF, epochTrialKey)
% NEW (FIX #6): [freq x time x nTrials] - averages over CHANNELS WITHIN
% EACH TRIAL only, keeping the frequency axis intact (unlike
% trial_averaged_trace above, which also collapses frequency and is used
% for a different purpose - line-trace outputs). This is the first stage
% of the two-stage "average channels within trial, then average trials"
% hierarchy: callers take mean(perTrialTF, 3, 'omitnan') as the second
% stage. Replaces the previous flat mean(normTF, 3) across every
% trial-channel epoch, which implicitly gave trials with more surviving
% channels more weight than trials with fewer.
    sortedKeys = unique(epochTrialKey);
    [nF, nT, ~] = size(normTF);
    perTrialTF = nan(nF, nT, numel(sortedKeys));
    for k = 1:numel(sortedKeys)
        mask = (epochTrialKey == sortedKeys(k));
        if ~any(mask), continue; end
        perTrialTF(:, :, k) = mean(normTF(:, :, mask), 3);
    end
end


function [normTF, avgTF] = double_zscore_normalize(epochsTF, time_ms, baselineWin_ms, method, baselineWin2_ms)
% epochsTF: [freq x time x epoch]
% Step 1: within-epoch z-score, per frequency, over the FULL analysis
%         window (each epoch normalized to its own mean/SD).
% Step 2: re-normalize using the mean/SD of the pooled baseline period(s),
%         pooled across epochs (trials x channels) AND across both
%         windows if two are given, per frequency.
%
% NOTE: the avgTF returned here is the FLAT mean(normTF,3) - kept for any
% caller that still wants it, but as of FIX #6 the main pipeline ignores
% this return value and computes avgTF itself via trial_averaged_tf's
% two-stage hierarchy instead (channels-within-trial, then trials).
    if nargin < 5
        baselineWin2_ms = [];
    end

    if strcmpi(method, 'log10Z')
        epochsTF = log10(epochsTF + eps);
    end

    [nF, nT, nE] = size(epochsTF);

    step1 = zeros(nF, nT, nE);
    for e = 1:nE
        mu = mean(epochsTF(:, :, e), 2);
        sd = std(epochsTF(:, :, e), 0, 2);
        sd(sd == 0) = eps;
        step1(:, :, e) = (epochsTF(:, :, e) - mu) ./ sd;
    end

    baseIdx = time_ms >= baselineWin_ms(1) & time_ms <= baselineWin_ms(2);
    if ~isempty(baselineWin2_ms)
        baseIdx = baseIdx | (time_ms >= baselineWin2_ms(1) & time_ms <= baselineWin2_ms(2));
    end
    if ~any(baseIdx)
        warning('Baseline window(s) have no samples in this epoch (range %g to %g ms) - skipping step-2 renormalization.', ...
            time_ms(1), time_ms(end));
        normTF = step1;
    else
        baselineVals = step1(:, baseIdx, :);
        baselineVals = reshape(baselineVals, nF, []);
        muBase = mean(baselineVals, 2);
        sdBase = std(baselineVals, 0, 2);
        sdBase(sdBase == 0) = eps;

        normTF = (step1 - muBase) ./ sdBase;
    end

    avgTF = mean(normTF, 3);  % flat mean - see note above; not used by the main pipeline as of FIX #6
end


function sens = run_highgamma_rebound_sensitivity(PID, cond, dataDir, nBlocks, ...
