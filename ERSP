function [dataOut, timeOut] = bin_time_axis(dataIn, time_ms, binMs)
% Bins a [rows x time] array down to binMs-wide time bins by averaging
% samples within each bin.
    dt = median(diff(time_ms));
    if isempty(binMs) || binMs <= dt
        dataOut = dataIn;
        timeOut = time_ms;
        return
    end

    edges = time_ms(1):binMs:time_ms(end);
    if isempty(edges) || edges(end) < time_ms(end)
        edges(end+1) = time_ms(end) + dt;  %#ok<AGROW>
    end
    nBins = numel(edges) - 1;

    nRows = size(dataIn, 1);
    dataOut = nan(nRows, nBins);
    timeOut = nan(1, nBins);

    for b = 1:nBins
        if b < nBins
            idx = time_ms >= edges(b) & time_ms < edges(b+1);
        else
            idx = time_ms >= edges(b) & time_ms <= edges(b+1);
        end
        if ~any(idx)
            continue
        end
        timeOut(b) = mean(time_ms(idx));
        dataOut(:, b) = mean(dataIn(:, idx), 2);
    end
end

function raw = load_quattrocento_block(rawFile, trigField, forceField, emgPrefix, nCh, fs) %#ok<INUSD>
% Loads one PID_COND_BLOCK.mat file and returns continuous trigger
% samples, force trace, and the 64-channel EMG matrix.
    S = load(rawFile);

    trigRaw  = get_field_flex(S, trigField);
    forceRaw = get_field_flex(S, forceField);

    emgRaw = cell(1, nCh);
    for ch = 1:nCh
        chName = sprintf('%s%d', emgPrefix, ch);
        emgRaw{ch} = get_field_flex(S, chName);
    end

    minLen = min([numel(trigRaw), numel(forceRaw), cellfun(@numel, emgRaw)]);
    maxLen = max([numel(trigRaw), numel(forceRaw), cellfun(@numel, emgRaw)]);
    if maxLen - minLen > 5
        warning(['Channel lengths in %s differ by %d samples (more than the usual ' ...
                 'off-by-one export quirk) - double check this file is not corrupted. ' ...
                 'Truncating all channels to the shortest (%d samples).'], ...
                 rawFile, maxLen - minLen, minLen);
    end

    trig = trigRaw(1:minLen);

    emg = zeros(nCh, minLen);
    for ch = 1:nCh
        emg(ch, :) = emgRaw{ch}(1:minLen);
    end

    thresh = max(trig) / 2;
    trigSamples = find(diff(trig > thresh) == 1) + 1;

    raw.trig = trig;
    raw.force = force_trim(forceRaw, minLen);
    raw.emg = emg;
    raw.trigSamples = trigSamples;
end


function v = force_trim(v, n)
    v = v(1:n);
end


function val = get_field_flex(S, fieldName)
% Fetches fieldName from struct S, unwrapping common OTBioLab+/
% Quattrocento export layouts.
    raw = [];
    if isfield(S, fieldName)
        raw = S.(fieldName);
    elseif isfield(S, 'Data') && isstruct(S.Data) && isfield(S.Data, fieldName)
        raw = S.Data.(fieldName);
    else
        error('Field %s not found in raw file (top-level or under .Data). Available top-level fields: %s', ...
            fieldName, strjoin(fieldnames(S), ', '));
    end

    if isnumeric(raw)
        val = double(raw);
    elseif isstruct(raw)
        subfieldCandidates = {'Data','data','values','Value','value','signal','y','samples'};
        hit = subfieldCandidates(isfield(raw, subfieldCandidates));
        if isempty(hit)
            error(['Field %s is a struct but none of the expected sample subfields ' ...
                   '(%s) were found. Its actual fields are: %s. Update get_field_flex ' ...
                   'with the correct subfield name.'], ...
                   fieldName, strjoin(subfieldCandidates, ', '), strjoin(fieldnames(raw), ', '));
        end
        val = double(raw.(hit{1}));
    else
        error('Field %s has unsupported type %s. Update get_field_flex for your file format.', ...
            fieldName, class(raw));
